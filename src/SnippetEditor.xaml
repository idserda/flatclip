<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlatClip – Snippet" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="20">
    <Border CornerRadius="12" Background="{DynamicResource BgBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.4" Color="#000000"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
      <StackPanel>
        <Grid x:Name="Header" Background="Transparent" Height="54">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <TextBlock Text="&#xE8EC;" FontFamily="{DynamicResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,1,10,0"/>
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                  HorizontalAlignment="Right" Margin="0,0,12,0"/>
        </Grid>

        <StackPanel Margin="22,4,22,0">
          <TextBlock Text="Naam" Style="{StaticResource Label}"/>
          <TextBlock Text="Hiermee vind je het snippet terug: typ de naam in het zoekveld en druk op Enter." Style="{StaticResource Desc}"/>
          <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="100"/>

          <TextBlock Text="Inhoud" Style="{StaticResource Label}" Margin="0,20,0,8"/>
          <TextBox x:Name="ContentBox" Style="{StaticResource AreaField}" Height="190"/>

          <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="14,14,22,16">
          <DockPanel>
            <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" DockPanel.Dock="Left">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <TextBlock Text="Verwijderen"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="Ctrl+Enter" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="CancelButton" Style="{StaticResource FlatButton}" Content="Annuleren" Margin="0,0,8,0"/>
              <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="Opslaan"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
