<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{{SettingsTitle}}" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="20">
    <Border CornerRadius="12" Background="{DynamicResource BgBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.4" Color="#000000"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
      <StackPanel>
        <Grid x:Name="Header" Background="Transparent" Height="54">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,1,10,0"/>
            <TextBlock Text="{{Settings}}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                  HorizontalAlignment="Right" Margin="0,0,12,0"/>
        </Grid>

        <StackPanel Margin="22,4,22,0">
          <TextBlock Text="{{Hotkey}}" Style="{StaticResource Label}"/>
          <TextBlock Text="{{HotkeyDesc}}" Style="{StaticResource Desc}"/>
          <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"/>

          <TextBlock Text="{{KeepHistory}}" Style="{StaticResource Label}" Margin="0,22,0,0"/>
          <TextBlock Text="{{KeepHistoryDesc}}" Style="{StaticResource Desc}"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="DaysBox" Style="{StaticResource Field}" Width="80" MaxLength="4" HorizontalContentAlignment="Center"/>
            <TextBlock Text="{{Days}}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>

          <TextBlock Text="{{Theme}}" Style="{StaticResource Label}" Margin="0,22,0,10"/>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource Segment}" Content="{{ThemeDark}}"/>
              <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource Segment}" Content="{{ThemeLight}}"/>
              <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource Segment}" Content="{{ThemeSystem}}"/>
            </StackPanel>
          </Border>

          <CheckBox x:Name="AutoStart" Style="{StaticResource Toggle}" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="{{StartWithWindows}}" Style="{StaticResource Label}"/>
              <TextBlock Text="{{StartWithWindowsDesc}}" Style="{StaticResource Desc}" Margin="0,2,0,0"/>
            </StackPanel>
          </CheckBox>

          <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="14,14,22,16">
          <DockPanel>
            <Button x:Name="ClearButton" Style="{StaticResource DangerButton}" DockPanel.Dock="Left">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <TextBlock Text="{{ClearHistory}}"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CancelButton" Style="{StaticResource FlatButton}" Content="{{Cancel}}" Margin="0,0,8,0"/>
              <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="{{Save}}" IsDefault="True"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
